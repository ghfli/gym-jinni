# Multi-stage build for Main Service
FROM golang:1.18-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make protobuf protobuf-dev

# Set working directory
WORKDIR /build

# Copy go mod files
COPY service/go.mod service/go.sum ./service/
WORKDIR /build/service
RUN go mod download

# Copy source code
WORKDIR /build
COPY service/ ./service/

# Build the service
WORKDIR /build/service
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o service .

# Final stage
FROM alpine:3.18

# Install runtime dependencies
RUN apk add --no-cache ca-certificates bash curl

# Create app directory
WORKDIR /app/service

# Copy binary from builder
COPY --from=builder /build/service/service /app/service/service

# Copy migrations
COPY service/mig/ /app/service/mig/

# Copy generated files if they exist
COPY service/gen/ /app/service/gen/ 2>/dev/null || true

# Expose ports
EXPOSE 8080 8081

# Set environment variables
ENV DBURL="postgresql://root:gj@postgres:5432/gj?sslmode=disable&search_path=public"

# Run the service
CMD ["/app/service/service"]

