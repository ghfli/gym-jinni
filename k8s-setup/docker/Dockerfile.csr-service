# Multi-stage build for CSR Service
FROM golang:1.18-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make protobuf protobuf-dev

# Set working directory
WORKDIR /build

# Copy go mod files
COPY csr_service/go.mod csr_service/go.sum ./csr_service/
WORKDIR /build/csr_service
RUN go mod download

# Copy source code
WORKDIR /build
COPY csr_service/ ./csr_service/

# Build the service
WORKDIR /build/csr_service
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o service .

# Final stage
FROM alpine:3.18

# Install runtime dependencies
RUN apk add --no-cache ca-certificates bash curl

# Create app directory
WORKDIR /app/csr_service

# Copy binary from builder
COPY --from=builder /build/csr_service/service /app/csr_service/service

# Copy migrations
COPY csr_service/mig/ /app/csr_service/mig/

# Copy generated files if they exist
COPY csr_service/gen/ /app/csr_service/gen/ 2>/dev/null || true

# Expose ports
EXPOSE 8082 8083

# Set environment variables
ENV DBURL="postgresql://root:gj@postgres:5432/gj?sslmode=disable&search_path=public"

# Run the service
CMD ["/app/csr_service/service"]

