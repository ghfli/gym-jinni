# Multi-stage build for Flutter UI
FROM docker.io/library/ubuntu:24.04 AS builder

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    unzip \
    xz-utils \
    zip \
    libglu1-mesa \
    && rm -rf /var/lib/apt/lists/*

# Install Flutter
RUN git clone https://github.com/flutter/flutter.git -b stable /flutter
ENV PATH="/flutter/bin:${PATH}"
# Prevent tar from failing on uid/gid chown in restricted user namespaces (CI)
ENV TAR_OPTIONS="--no-same-owner"

# Enable web support
RUN flutter config --enable-web \
    && flutter precache --web

# Set working directory
WORKDIR /app

# Copy pubspec files
COPY ui/pubspec.yaml ui/pubspec.lock ./

# Get dependencies
RUN flutter pub get

# Copy source code
COPY ui/ ./

# Build web app
RUN flutter build web --release

# Final stage - nginx to serve the app
FROM docker.io/library/nginx:stable-alpine

# Copy built web app
COPY --from=builder /app/build/web /usr/share/nginx/html

# Copy nginx configuration
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    location /api/ { \
        proxy_pass http://main-service:8081/; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
    } \
    location /rbac/ { \
        proxy_pass http://main-service:8081/; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
    } \
}' > /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
