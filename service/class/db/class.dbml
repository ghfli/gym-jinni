Project gymjinni_class {
  datebase_type: 'PostgreSQL'
  Note: 'gymjinni class management database schema'
}

Table class.class {
  id serial [pk]
  created_by int // [ref: > user.user.id ]
  description varchar [not null]
  start_time timestamptz [not null]
  end_time timestamptz [not null]
  min_hdcnt int
  max_hdcnt int
}

// Migration 000013 enforces start_time < end_time and nonnegative capacities.
// max_hdcnt=0 means unlimited; finite maximum must be >= minimum.
